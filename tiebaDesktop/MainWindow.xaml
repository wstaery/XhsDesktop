<Window x:Class="TiebaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="百度贴吧.docx - Word"
        Width="1200" Height="800" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FFF3F2F1"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- 标题栏窗口按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF323130" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE5E3E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD9D7D5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF323130" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1707A" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 功能区 -->
        <Style x:Key="RibbonTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="White" BorderBrush="#FFE1DFDD" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="4,0,0,0" VerticalAlignment="Stretch" />
                            </Border>
                            <Border Grid.Row="1" Background="White" BorderBrush="#FFE1DFDD" BorderThickness="0,0,0,1">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Margin="0,0,2,0">
                            <Border x:Name="Hover" Background="Transparent" CornerRadius="4,4,0,0" Margin="2,2,2,0" />
                            <Border x:Name="Accent" Height="3" VerticalAlignment="Bottom" Margin="6,0" CornerRadius="1.5" Background="Transparent" />
                            <TextBlock x:Name="Txt"
                                       Text="{TemplateBinding Header}"
                                       FontSize="12.5"
                                       Foreground="#FF444444"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="10,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#FFF2F0EE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Accent" Property="Background" Value="#FF2B579A" />
                                <Setter TargetName="Txt" Property="Foreground" Value="#FF2B579A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF323130" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="2,4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="#FF2B579A"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="10.5"
                                           Margin="0,4,0,0"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEDEBE9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE1DFDD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="#FFE8E6E3" />
            <Setter Property="Margin" Value="4,8,4,12" />
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#FF8A8886" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="FauxControl" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD0CECB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="FauxText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FF323130" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF605E5C" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF605E5C" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE5E3E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD9D7D5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF605E5C" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE5E3E1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFDEEBF7" />
                                <Setter TargetName="Txt" Property="Foreground" Value="#FF2B579A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder" Background="#FFF3F2F1" BorderBrush="#FFD0CECB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ───────── 标题栏（Word 风格） ───────── -->
            <Grid Grid.Row="0" Background="#FFF3F2F1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="Assets/app.ico" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#FF323130">
                        <Run Text="百度贴吧.docx" />
                        <Run Text=" - Word" Foreground="#FF605E5C" />
                    </TextBlock>
                    <TextBlock Text="已保存到 OneDrive" FontSize="10.5" Foreground="#FF8A8886"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ───────── 功能区 ───────── -->
            <TabControl Grid.Row="1" x:Name="RibbonTabs" Style="{StaticResource RibbonTabControl}" SelectedIndex="0">

                <!-- 开始 -->
                <TabItem Header="开始" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">

                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button x:Name="BackButton" Style="{StaticResource BigButton}" Content="后退" Tag="&#xE72B;" Click="BackButton_Click" />
                                <Button x:Name="ForwardButton" Style="{StaticResource BigButton}" Content="前进" Tag="&#xE72A;" Click="ForwardButton_Click" />
                                <Button Style="{StaticResource BigButton}" Content="刷新" Tag="&#xE72C;" Click="RefreshButton_Click" />
                                <Button Style="{StaticResource BigButton}" Content="首页" Tag="&#xE80F;" Click="HomeButton_Click" />
                            </StackPanel>
                            <TextBlock Text="浏览" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />

                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="粘贴" Tag="&#xE77F;" />
                                <Button Style="{StaticResource BigButton}" Content="剪切" Tag="&#xE8C6;" />
                                <Button Style="{StaticResource BigButton}" Content="复制" Tag="&#xE8C8;" />
                            </StackPanel>
                            <TextBlock Text="剪贴板" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />

                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Height="64">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource FauxControl}" Width="112">
                                        <TextBlock Text="等线 (正文)" Style="{StaticResource FauxText}" />
                                    </Border>
                                    <Border Style="{StaticResource FauxControl}" Width="52" Margin="4,0,0,0">
                                        <TextBlock Text="11" Style="{StaticResource FauxText}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Style="{StaticResource FauxControl}" Width="26">
                                        <TextBlock Text="B" FontWeight="Bold" Style="{StaticResource FauxText}" />
                                    </Border>
                                    <Border Style="{StaticResource FauxControl}" Width="26" Margin="3,0,0,0">
                                        <TextBlock Text="I" FontStyle="Italic" Style="{StaticResource FauxText}" />
                                    </Border>
                                    <Border Style="{StaticResource FauxControl}" Width="26" Margin="3,0,0,0">
                                        <TextBlock Text="U" TextDecorations="Underline" Style="{StaticResource FauxText}" />
                                    </Border>
                                    <Border Style="{StaticResource FauxControl}" Width="30" Margin="3,0,0,0">
                                        <TextBlock Text="A" Foreground="#FFC00000" FontSize="10" Style="{StaticResource FauxText}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="字体" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />

                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Border Style="{StaticResource FauxControl}" Width="26">
                                    <TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource FauxText}" />
                                </Border>
                                <Border Style="{StaticResource FauxControl}" Width="26" Margin="3,0,0,0">
                                    <TextBlock Text="&#xE8E3;" FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource FauxText}" />
                                </Border>
                                <Border Style="{StaticResource FauxControl}" Width="26" Margin="3,0,0,0">
                                    <TextBlock Text="&#xE8E2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource FauxText}" />
                                </Border>
                                <Border Style="{StaticResource FauxControl}" Width="26" Margin="3,0,0,0">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource FauxText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="段落" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />

                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Border Style="{StaticResource FauxControl}" Width="62" Margin="0,0,4,0">
                                    <TextBlock Text="正文" Style="{StaticResource FauxText}" />
                                </Border>
                                <Border Style="{StaticResource FauxControl}" Width="62" Margin="0,0,4,0">
                                    <TextBlock Text="标题 1" Style="{StaticResource FauxText}" />
                                </Border>
                                <Border Style="{StaticResource FauxControl}" Width="62">
                                    <TextBlock Text="标题 2" Style="{StaticResource FauxText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="样式" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 插入 -->
                <TabItem Header="插入" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="封面" Tag="&#xE7C3;" />
                                <Button Style="{StaticResource BigButton}" Content="空白页" Tag="&#xE8A5;" />
                                <Button Style="{StaticResource BigButton}" Content="分页符" Tag="&#xE8A7;" />
                            </StackPanel>
                            <TextBlock Text="页面" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="表格" Tag="&#xE80A;" />
                                <Button Style="{StaticResource BigButton}" Content="图片" Tag="&#xEB9F;" />
                                <Button Style="{StaticResource BigButton}" Content="形状" Tag="&#xE7C4;" />
                            </StackPanel>
                            <TextBlock Text="插图" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="链接" Tag="&#xE71B;" />
                                <Button Style="{StaticResource BigButton}" Content="批注" Tag="&#xE90A;" />
                                <Button Style="{StaticResource BigButton}" Content="页眉" Tag="&#xE8A8;" />
                            </StackPanel>
                            <TextBlock Text="链接" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 设计 -->
                <TabItem Header="设计" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="主题" Tag="&#xE790;" />
                                <Button Style="{StaticResource BigButton}" Content="颜色" Tag="&#xE7C1;" />
                                <Button Style="{StaticResource BigButton}" Content="字体" Tag="&#xE8D2;" />
                            </StackPanel>
                            <TextBlock Text="文档格式" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="水印" Tag="&#xE7C3;" />
                                <Button Style="{StaticResource BigButton}" Content="页面边框" Tag="&#xE7C4;" />
                            </StackPanel>
                            <TextBlock Text="页面背景" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 布局 -->
                <TabItem Header="布局" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="页边距" Tag="&#xE7C3;" />
                                <Button Style="{StaticResource BigButton}" Content="方向" Tag="&#xE8B3;" />
                                <Button Style="{StaticResource BigButton}" Content="大小" Tag="&#xE7C4;" />
                                <Button Style="{StaticResource BigButton}" Content="分栏" Tag="&#xE8A9;" />
                            </StackPanel>
                            <TextBlock Text="页面设置" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="缩进" Tag="&#xE8E2;" />
                                <Button Style="{StaticResource BigButton}" Content="间距" Tag="&#xE8E4;" />
                            </StackPanel>
                            <TextBlock Text="段落" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 引用 -->
                <TabItem Header="引用" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="目录" Tag="&#xE8A5;" />
                                <Button Style="{StaticResource BigButton}" Content="更新目录" Tag="&#xE72C;" />
                            </StackPanel>
                            <TextBlock Text="目录" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="脚注" Tag="&#xE8A7;" />
                                <Button Style="{StaticResource BigButton}" Content="尾注" Tag="&#xE8A8;" />
                            </StackPanel>
                            <TextBlock Text="脚注" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 审阅 -->
                <TabItem Header="审阅" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="拼写检查" Tag="&#xE8C8;" />
                                <Button Style="{StaticResource BigButton}" Content="字数统计" Tag="&#xE8A5;" />
                            </StackPanel>
                            <TextBlock Text="校对" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="新建批注" Tag="&#xE90A;" />
                                <Button Style="{StaticResource BigButton}" Content="删除" Tag="&#xE74D;" />
                            </StackPanel>
                            <TextBlock Text="批注" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 视图 -->
                <TabItem Header="视图" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="阅读视图" Tag="&#xE7C3;" />
                                <Button Style="{StaticResource BigButton}" Content="页面视图" Tag="&#xE8A5;" />
                                <Button Style="{StaticResource BigButton}" Content="网页版式" Tag="&#xE774;" />
                            </StackPanel>
                            <TextBlock Text="视图" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupSeparator}" />
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="标尺" Tag="&#xE8A9;" />
                                <Button Style="{StaticResource BigButton}" Content="网格线" Tag="&#xE80A;" />
                                <Button Style="{StaticResource BigButton}" Content="导航窗格" Tag="&#xE8A0;" />
                            </StackPanel>
                            <TextBlock Text="显示" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 帮助 -->
                <TabItem Header="帮助" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="94" Margin="10,4,0,0">
                        <StackPanel Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal" Height="64">
                                <Button Style="{StaticResource BigButton}" Content="帮助" Tag="&#xE897;" />
                                <Button Style="{StaticResource BigButton}" Content="反馈" Tag="&#xE939;" />
                                <Button Style="{StaticResource BigButton}" Content="关于" Tag="&#xE946;" />
                            </StackPanel>
                            <TextBlock Text="帮助" Style="{StaticResource GroupLabel}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- ───────── 文档页面（网页内容） ───────── -->
            <Border Grid.Row="2" Background="#FFEDEDED">
                <Grid Margin="26,16,26,16">
                    <Border Background="White" BorderBrush="#FFC8C6C4" BorderThickness="1">
                        <wv2:WebView2 x:Name="WebView" />
                    </Border>
                </Grid>
            </Border>

            <!-- ───────── 状态栏 ───────── -->
            <Border Grid.Row="3" Background="#FFF3F2F1" BorderBrush="#FFE1DFDD" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="第 1 页，共 1 页" Style="{StaticResource StatusText}" />
                        <TextBlock Text="0 个字" Style="{StaticResource StatusText}" Margin="18,0,0,0" />
                        <TextBlock Text="中文(中国)" Style="{StaticResource StatusText}" Margin="18,0,0,0" />
                        <TextBlock Text="网页视图" Style="{StaticResource StatusText}" Margin="18,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="TopmostToggle" Content="置顶" Style="{StaticResource StatusToggle}"
                                      Checked="TopmostToggle_Changed" Unchecked="TopmostToggle_Changed" />
                        <ToggleButton x:Name="AdBlockToggle" Content="拦截" Style="{StaticResource StatusToggle}"
                                      Margin="2,0,0,0" Checked="AdBlockToggle_Changed" Unchecked="AdBlockToggle_Changed" />
                        <Button Content="托盘" Style="{StaticResource StatusButton}" Margin="2,0,0,0" Click="TrayButton_Click" />
                        <Border Width="1" Height="14" Background="#FFD9D7D5" Margin="8,0" />
                        <TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#FF605E5C" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Width="90" Minimum="60" Maximum="200" Value="100"
                                VerticalAlignment="Center" IsHitTestVisible="False" IsTabStop="False" />
                        <TextBlock Text="100%" Style="{StaticResource StatusText}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
